{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the trusted main webview only (preview child webviews have no IPC)",
  "webviews": ["main"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview",
    "opener:default",
    "dialog:default"
  ]
}
